          "pointer": "/name",
          "role": "title"
        },
        {
          "pointer": "/room",
          "role": "destination",
          "resolveWith": "sample.plants.rooms"
        },
        {
          "pointer": "/notes",
          "role": "detail",
          "widget": "long"
        }
      ]
    }

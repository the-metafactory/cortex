        "outputSchemaRef": {
          "schemaId": "sample.plants.room-list",
          "version": "1.0.0"
        },
        "errorSchemaRef": {
          "schemaId": "sample.plants.error",
          "version": "1.0.0"
        }
      },
      {
        "capabilityId": "sample.plants.thirsty",
        "label": "Plants that need water",
        "kind": "observation",
        "objectTypes": [
          "plant"

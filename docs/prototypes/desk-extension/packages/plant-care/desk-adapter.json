                },
                "canonicalId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "roomName": {
              "type": "string",
              "minLength": 1
            },
            "wateringIntervalHours": {
              "type": "integer",
              "minimum": 1
            },
            "lastWatered": {
              "type": "string",
              "format": "date-time"
            },
            "nextWaterDue": {
              "type": "string",
              "format": "date"
            },
            "careNote": {
              "type": "string"
            }
          }
        }
      },
      {
        "schemaId": "sample.plants.plant-list",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "urn:desk-schema:sample.plants.plant:1.0.0"
              }
            }
          }
        }
      },
      {
        "schemaId": "sample.plants.room-list",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "urn:desk-schema:sample.plants.room:1.0.0"
              }
            }
          }
        }
      },
      {
        "schemaId": "sample.plants.search-input",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",

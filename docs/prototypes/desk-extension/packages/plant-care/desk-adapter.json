            }
          }
        }
      },
      {
        "schemaId": "sample.plants.get-input",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalId"
          ],
          "properties": {
            "canonicalId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "schemaId": "sample.plants.add-input",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [

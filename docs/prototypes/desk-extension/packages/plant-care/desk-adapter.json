            "room": {
              "type": "object",
              "title": "Room",
              "additionalProperties": false,
              "required": [
                "adapterId",
                "connectionId",
                "objectType",
                "canonicalId"
              ],
              "properties": {
                "adapterId": {
                  "type": "string",

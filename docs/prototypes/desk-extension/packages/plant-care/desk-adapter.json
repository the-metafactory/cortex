{
  "format": "desk-adapter-package/1",
  "packageId": "sample.plants",
  "packageVersion": "1.0.0",
  "deskSdkRange": "^1.0.0",
  "domainContractVersion": "1.0.0",
  "backend": {
    "entry": "backend.mjs",
    "sha256": "598c04923dd80549d284f3bba60fbf8767078150be4128a2fb4320f4cc09c4a5"
  },
  "declaration": {
    "adapterId": "sample.plants",
    "label": "Plant care",
    "contractRange": "^1.0.0",

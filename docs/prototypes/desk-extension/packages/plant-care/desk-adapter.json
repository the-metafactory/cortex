      "mode": "query",
      "objectType": "plant",
      "inputSchemaRef": {
        "schemaId": "sample.plants.search-input",
        "version": "1.0.0"
      },
      "outputSchemaRef": {
        "schemaId": "sample.plants.plant-list",
        "version": "1.0.0"
      },
      "textPointer": "/text",
      "destinationType": "room",
      "display": {
        "title": "/name",
        "summary": "/careNote"
      }
    }

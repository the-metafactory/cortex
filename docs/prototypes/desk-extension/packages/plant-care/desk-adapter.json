          "schemaId": "sample.plants.get-input",
          "version": "1.0.0"
        },
        "outputSchemaRef": {
          "schemaId": "sample.plants.plant",
          "version": "1.0.0"
        },
        "errorSchemaRef": {
          "schemaId": "sample.plants.error",
          "version": "1.0.0"
        }
      },
      {
        "capabilityId": "sample.plants.add",
        "label": "Add a plant",
        "kind": "action",
        "objectTypes": [
          "plant"
        ],
        "inputSchemaRef": {
          "schemaId": "sample.plants.add-input",
          "version": "1.0.0"
        },
        "outputSchemaRef": {
          "schemaId": "sample.plants.add-output",
          "version": "1.0.0"
        },
        "errorSchemaRef": {
          "schemaId": "sample.plants.error",
          "version": "1.0.0"
        }
      }
    ]
  },

      {
        "schemaId": "sample.plants.empty",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      },
      {
        "schemaId": "sample.plants.error",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      {
        "schemaId": "sample.plants.room",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "schemaId": "sample.plants.plant",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "species",
            "room",
            "roomName",
            "wateringIntervalHours",
            "lastWatered",
            "nextWaterDue",
            "careNote"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "species": {
              "type": "string"
            },
            "room": {
              "type": "object",
              "title": "Room",
              "additionalProperties": false,
              "required": [
                "adapterId",
                "connectionId",
                "objectType",
                "canonicalId"
              ],
              "properties": {
                "adapterId": {
                  "type": "string",
                  "const": "sample.plants"
                },
                "connectionId": {
                  "type": "string",
                  "minLength": 1
                },
                "objectType": {
                  "type": "string",

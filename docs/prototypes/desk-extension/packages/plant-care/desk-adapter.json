                "objectType": {
                  "type": "string",
                  "const": "room"
                },
                "canonicalId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "wateringIntervalDays": {
              "type": "number",
              "minimum": 1,
              "title": "Water every (days)"
            },
            "notes": {
              "type": "string",
              "title": "Care notes"
            }
          }
        }
      },
      {
        "schemaId": "sample.plants.add-output",
        "version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [

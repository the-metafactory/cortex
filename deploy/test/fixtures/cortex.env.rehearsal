# deploy/test/fixtures/cortex.env.rehearsal — placeholder env contract for the
# registry install-rehearsal (cortex#2287). PLACEHOLDER-ONLY, by rule: every
# value here is a dummy. NO real Discord snowflakes, NO real tokens, NO real
# slugs — ever (confidentiality standard: compass/standards/data-classification.md).
#
# Shapes satisfy `cortex quickstart`'s env-contract validation
# (quickstart-lib.ts): slugs/principals are lowercase letter-first, snowflakes
# are 1-20 decimal digits, secrets are presence-checked only (never echoed).
#
# EXPECTED OUTCOME with these values: quickstart provisioning (steps 1-6)
# passes; the surface CANNOT log in (dummy Discord token), so the run fails at
# the services/gate leg (steps 7-8). That expected-fail is asserted by
# install-rehearsal-debian.sh. The full-token leg is the manual part of D2.

# ── Identity ────────────────────────────────────────────────────────────────
CTX_PRINCIPAL=rehearsal-principal
CTX_SLUG=rehearsalslug

# ── Bus ports (scaffold defaults) ───────────────────────────────────────────
CTX_NATS_PORT=4222
CTX_NATS_MON=8222

# ── Discord ids (numeric placeholder snowflakes) ────────────────────────────
CTX_GUILD_ID=100000000000000001
CTX_CHANNEL_ID=100000000000000002
CTX_LOG_CHANNEL_ID=100000000000000003
CTX_MY_DISCORD_ID=100000000000000004

# ── Secrets (dummy — the rehearsal asserts provisioning, not surface login) ─
CTX_DISCORD_TOKEN=dummy-rehearsal-token
CLAUDE_CODE_OAUTH_TOKEN=dummy-rehearsal-oauth
